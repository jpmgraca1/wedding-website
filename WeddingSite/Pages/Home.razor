@page "/"

<PageTitle>Margarida & João</PageTitle>

<div class="landing-container">
    <div class="hero-section">
        <div class="hero-content">
            <img src="pic-site-flowerbar/Picture1.png" alt="Barra decorativa de flores" class="flower-bar" />
            <h1 class="couple-names">Margarida & João</h1>
            <div class="decorative-line"></div>
            <p class="wedding-date">12 . 09 . 2026</p>
            <p class="tagline">Vamos casar!</p>
            <div class="hero-cta">
                <a href="/rsvp" class="btn-wedding">RSVP</a>
            </div>
        </div>
        <div class="scroll-indicator">
            <span>↓</span>
        </div>
    </div>

    <div class="photo-gallery">
        <div class="photo-row">
            <div class="photo-card">
                <img src="pics/JP&M (101).JPG" alt="Margarida e João" />
            </div>
            <div class="photo-card">
                <img src="pics/JP&M (142).JPG" alt="Margarida e João" />
            </div>
        </div>
        <div class="photo-row">
            <div class="photo-card">
                <img src="pics/JP&M (277).JPG" alt="Margarida e João" />
            </div>
            <div class="photo-card">
                <img src="pics/JP&M (297).JPG" alt="Margarida e João" />
            </div>
        </div>
    </div>

    <!-- Adicionar ao Calendário -->
    <div class="calendar-section-home">
        <h2>Adicionem ao Vosso Calendário</h2>
        <p class="calendar-subtitle">Não percam o nosso grande dia!</p>
        
        <div class="calendar-buttons-home">
            <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Casamento%20Margarida%20%26%20Jo%C3%A3o&dates=20260912T140000/20260913T020000&details=Celebrem%20connosco%20o%20nosso%20dia%20especial!%0A%0ACerim%C3%B3nia:%20Igreja%20de%20Nossa%20Senhora%20dos%20Prazeres%20(14:00)%0ARece%C3%A7%C3%A3o:%20Quinta%20Nova%20do%20Hespanhol%20(16:00)&location=Igreja%20de%20Nossa%20Senhora%20dos%20Prazeres,%20Aldeia%20Galega%20da%20Merceana" target="_blank" class="btn-calendar-home google">
                <img src="pic-google-calendar/Google_Calendar_icon_(2020).svg.png" alt="Google Calendar" class="calendar-icon-img-home" />
                <span>Google Calendar</span>
            </a>
            
            <a href="data:text/calendar;charset=utf8,BEGIN:VCALENDAR%0AVERSION:2.0%0APRODID:-//Casamento%20Margarida%20%26%20Jo%C3%A3o//PT%0ABEGIN:VEVENT%0ADTSTART:20260912T140000%0ADTEND:20260913T020000%0ASUMMARY:Casamento%20Margarida%20%26%20Jo%C3%A3o%0ADESCRIPTION:Celebrem%20connosco%20o%20nosso%20dia%20especial!%0ALOCATION:Igreja%20de%20Nossa%20Senhora%20dos%20Prazeres%0ASTATUS:CONFIRMED%0ABEGIN:VALARM%0ATRIGGER:-P1D%0AACTION:DISPLAY%0ADESCRIPTION:Lembrete:%20Casamento%20amanh%C3%A3!%0AEND:VALARM%0AEND:VEVENT%0AEND:VCALENDAR" download="casamento-margarida-joao.ics" class="btn-calendar-home apple">
                <img src="pic-apple-calendar/purepng.com-apple-logologobrand-logoiconslogos-251519938788qhgdl.png" alt="Apple Calendar" class="calendar-icon-img-home" />
                <span>Apple Calendar</span>
            </a>
        </div>
    </div>

    <!-- Explorar Mais Seção -->
    <div class="explore-more-section">
        <h2>Explorem Mais</h2>
        <p class="explore-subtitle">Descubram todos os detalhes do nosso grande dia</p>
        
        <div class="explore-links">
            <a href="/information" class="explore-card">
                <div class="explore-icon">📍</div>
                <h3>Informações</h3>
                <p>Local e horários da cerimónia e receção</p>
            </a>
            
            <a href="/hotels" class="explore-card">
                <div class="explore-icon">🏨</div>
                <h3>Onde Ficar</h3>
                <p>Sugestões de alojamento na região</p>
            </a>
            
            <a href="/honeymoon" class="explore-card">
                <div class="explore-icon">✈️</div>
                <h3>Lua de Mel</h3>
                <p>A nossa próxima aventura pelo mundo</p>
            </a>
            
            <a href="/rsvp" class="explore-card">
                <div class="explore-icon">✉️</div>
                <h3>RSVP</h3>
                <p>Confirmem a vossa presença</p>
            </a>
        </div>

        <img src="pic-site-flowerbar/Picture2.png" alt="Barra decorativa de flores" class="flower-bar-bottom" />
    </div>
</div>
